# LLM_PROVIDER selects which SDK/API every agent below uses: anthropic | openai | gemini.
# Set the one matching API key for whichever provider you pick; model names below are
# provider-native strings, so switching providers means changing LLM_PROVIDER + these
# model IDs together (see src/tools/llm_factory.py). No code changes needed either way.
LLM_PROVIDER=anthropic

# --- anthropic (default) ---
ANTHROPIC_API_KEY=

# --- openai (set LLM_PROVIDER=openai to use) ---
OPENAI_API_KEY=

# --- gemini (set LLM_PROVIDER=gemini to use) ---
GOOGLE_API_KEY=

TAVILY_API_KEY=
# LANGCHAIN_TRACING_V2 must be a real bool -- langgraph_api's config loader
# (used by `langgraph dev`) rejects an empty string at startup.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false

# When set, every LLM call (across all agents) is throttled process-wide to at
# most this many requests per rolling 60s window -- for low-tier providers with
# a hard RPM cap (e.g. Gemini free tier: 10-15 RPM). Leave unset/0 for
# providers with generous limits (Anthropic/OpenAI paid tiers).
LLM_RPM_LIMIT=

# Per-agent model names (plan section 16 prompt pack). Defaults below are Claude
# Haiku 4.5. Swap all six to the equivalent model for whichever provider is active,
# e.g. gpt-4o-mini/gpt-4o for openai, gemini-2.5-flash-lite for gemini (cheapest
# Gemini model token-wise as of Aug 2026; set LLM_RPM_LIMIT=8 alongside it if on
# the free tier).
ANALYST_MODEL=claude-haiku-4-5-20251001
CRITIC_MODEL=claude-haiku-4-5-20251001
CONTENT_MODEL=claude-haiku-4-5-20251001
CONTENT_VALIDATOR_MODEL=claude-haiku-4-5-20251001
REPORT_SUMMARY_MODEL=claude-haiku-4-5-20251001
EMAIL_EXTRACTOR_MODEL=claude-haiku-4-5-20251001

# --- prompt caching (src/tools/prompt_cache.py) ---
# LLM_PROMPT_CACHE=0 disables all prompt caching. Default on; costs nothing.
#   Anthropic: cache_control markers on the system prompt (required for any
#     caching at all on that provider).
#   OpenAI:    automatic above the provider's minimum; nothing to configure.
# LLM_PROMPT_CACHE_GEMINI_EXPLICIT=1 opts into Gemini explicit context caching.
#   Off by default: creating a cache costs an HTTP round-trip that CANNOT
#   succeed on the free tier (TotalCachedContentStorageTokensPerModelFreeTier
#   limit=0). Enable on a paid tier; confirm hits via cache_read_tokens in
#   LLM_TELEMETRY_PATH.
# LLM_PROMPT_CACHE_TTL_SECONDS=1800 how long a Gemini cache is kept alive.
